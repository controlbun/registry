.env
.env.*
NOTES-private.md

# private working material, never committed
_local/

# a sign-in capture is a dated statement about a real person, carrying whatever
# the provider chose to return. `artifacts/claims.jsonl` is the tracked half and
# carries the fields the row carries and no others; `artifacts/claim.py` is the
# projection between them, and `tests/test_claim_record.py` fails the build on a
# version of it that copies the capture instead.
artifacts/memberships.jsonl
__pycache__/
*.pyc
.DS_Store

# agent session state, not the working agreement
.claude/
.claude*/
!CLAUDE.md
.cursor/
.aider*
.continue/
**/transcripts/
*.transcript
*.session.json

# local venv and the editable-install metadata it writes
.venv/
*.egg-info/

# generated database, rebuild with artifacts/seed.py
registry.db

# fetched artifacts, keyed by commit so they never go stale and never
# need clearing. Rebuilt on demand from the Hub.
.cache/

# tensors `tests/probe.py` writes at test time. Never committed: a checked-in
# fabricated artifact is exactly what left the tree on 2026-09-19, and these
# regenerate from an integer ramp on every run.
tests/_probe/

# astro build output and dependencies
astro/node_modules/
astro/dist/
astro/.astro/
