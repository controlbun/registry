---
import Base from "../layouts/Base.astro";
import Claimant from "../components/Claimant.astro";
import Pairs from "../components/Pairs.astro";
import data from "../data/registry.json";

// Not the front door any more, and still here on purpose. A label across every
// claimant is the plurality view itself: the one page where several people meaning
// different things by the same word sit next to each other. Reached from a model
// page rather than browsed first, because a reader picks a model before they pick
// a construct.
export function getStaticPaths() {
  return data.labels.map((entry) => ({
    params: { label: entry.label },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const models = [...new Set(
  entry.claimants.map((c) => c.model_id).filter(Boolean),
)];
---

<Base title={`${entry.label} — claimants`} crumb="all models">
  <h1 slot="heading">{entry.label}</h1>

  <p class="lede">
    A view across everyone claiming this label, computed on demand and owned by
    nobody. It does not resolve to an artifact. {entry.claimants.length} claimants
    across {models.length} model{models.length === 1 ? "" : "s"}.
  </p>

  <div class="scope">
    <div>
      <span class="k">Models carrying this label</span>
      {models.map((m) => (
        <div><a class="mono" href={`/models/${m}/`}>{m}</a></div>
      ))}
    </div>
  </div>

  <div data-pagefind-body>
    {entry.claimants.map((c) => <Claimant claimant={c} />)}

    <h2>Between claimants</h2>
    <Pairs pairs={entry.pairs} />

    <p class="note">
      Claimants on different models appear here together because they claim the same
      word, not because their artifacts are interchangeable. Angle similarity reads
      as not comparable across models, which is the honest answer rather than a
      missing value.
    </p>
  </div>
</Base>
