<script>
  import {
    authorizeUrl,
    chosenRoute,
    downloadName,
    inArrivalOrder,
    nowStamp,
    pasteFrom,
    pendingRowFrom,
    pkcePair,
    playback,
    refuseOurNamespace,
    signerFrom,
    submissionFrom,
    WRITE_SCOPES,
    Refused,
  } from "../lib/handshake.mjs";
  import {
    commit,
    createRepo,
    digestOf,
    exchange,
    HubError,
    inlineFile,
    putLfs,
    readPending,
    sendPending,
    uploadMode,
  } from "../lib/hub.mjs";
  import { restore, resume, staleSaid, usable } from "../lib/held.mjs";

  const config = document.getElementById("handshake").dataset;
  const SUPABASE = config.supabaseUrl;
  const KEY = config.supabaseKey;

  // Where the permission window lands, which is not this page.
  //
  // The redirect URL registered with the identity service is `/signed-in/` and
  // adding a second one is a console change only the account holder can make.
  // Nothing here needs it: that page relays the code to whoever opened the
  // window and closes, this window holds the verifier, and the exchange happens
  // here. So the round trip works from any page that can open a window, which
  // is what let the form move off the return leg at all.
  const RETURN_TO = new URL("/signed-in/", location.origin).href;

  // The one thing that survives a navigation, because a PKCE verifier has to by
  // definition. Removed the moment it is used, and it is not a credential for
  // anything on its own: without the authorization code it exchanges for
  // nothing. The session lives under its own key and `held.mjs` is the only
  // thing that writes it.
  const VERIFIER = "controlbun.pkce";
  // Names the window so a second press reuses it rather than stacking two
  // consent screens.
  const POPUP_NAME = "controlbun-scope";

  const show = (id, on = true) => {
    const node = document.getElementById(id);
    if (node) node.hidden = !on;
  };
  const say = (id, text) => {
    const node = document.getElementById(id);
    if (node) node.textContent = text;
  };

  function stop(problem) {
    show("working", false);
    show("failed", true);
    say(
      "failed",
      problem instanceof Refused || problem instanceof HubError
        ? problem.message
        : `${problem}`,
    );
  }

  function download(name, text) {
    const url = URL.createObjectURL(new Blob([text], { type: "application/json" }));
    const link = document.createElement("a");
    link.href = url;
    link.download = name;
    link.click();
    URL.revokeObjectURL(url);
  }

  // ------------------------------------------------------------------ //
  // Who is here, off the session this browser kept.

  // The session itself, held in one variable for the length of the page, and
  // written only by `held.mjs`.
  let signed = null;
  // Who the submission is built under: the three fields `submissionFrom` reads,
  // and never the session record, so a token is never one property access from
  // the thing being built.
  let signer = null;

  function ready(held, { renewed }) {
    signed = held;
    signer = signerFrom(held);
    say("namespace-shown", signer.preferred_username ?? "");
    say("offer-namespace", signer.preferred_username ?? "");
    show("working", false);
    show("nosession", false);
    show("stale", false);
    show("submit-section", Boolean(signer.preferred_username));
    show("remembered", true);
    say(
      "remembered",
      `This browser kept the session from a sign-in on ${held.recorded_at}, ` +
        "so Hugging Face was not asked again. " +
        (renewed
          ? "Its access token had expired and the identity service issued a " +
            "new one just now. "
          : "Its access token has not expired yet. ") +
        "What that session can do is put one row in the holding table as you. " +
        "It reads nobody else's rows, it changes and deletes nothing, and it " +
        "reaches nothing in your Hugging Face account. Sign out in the bar " +
        "deletes it from this browser, tells nobody, and does not end your " +
        "Hugging Face session.",
    );
    // Not awaited: the form above is usable while this runs, and a read that
    // fails says so in its own region rather than stopping the page.
    readBack("Reading back what this account has sent.");
  }

  /** A plain visit: restore, renew if the access token is spent, say which. */
  async function arrive() {
    if (!SUPABASE || !KEY) return;
    show("working", true);
    const answer = await resume(SUPABASE, KEY, { provider: config.provider });
    show("working", false);
    if (answer.state === "none") {
      show("nosession", true);
      return;
    }
    if (answer.state === "stale") {
      show("stale", true);
      say("stale", staleSaid(answer.problem));
      show("nosession", true);
      return;
    }
    ready(answer.held, { renewed: answer.state === "renewed" });
  }

  // The bar deletes the session on Sign out, and this page is one of the pages
  // it is sitting on. Without this, somebody who signs out here keeps a form
  // that would refuse on send with a sentence about a session that is already
  // gone.
  //
  // The records read back go with it, and they are removed from the document
  // rather than hidden inside it: the next person to sign in on this browser is
  // a different person, and a hidden element is still an element they can find.
  window.addEventListener("controlbun:session", () => {
    if (signed && !restore()) {
      signed = null;
      signer = null;
      forgetPlayed();
      show("submit-section", false);
      show("remembered", false);
      show("nosession", true);
    }
  });

  // ------------------------------------------------------------------ //
  // What this account has already sent, read back.
  //
  // Held in one variable and redrawn, rather than appended to, so the list on
  // screen is always the answer to one request. Wiped on sign out: a second
  // person signing in on the same browser must not find the first one's
  // records sitting in the document, hidden or otherwise.

  let sent = [];
  let newestFirst = false;

  /** One value as it was typed, quoted, and never parsed into anything. */
  function asTyped(text) {
    const said = document.createElement("span");
    said.className = "typed";
    said.textContent = text;
    return said;
  }

  function line(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  /** The `<dt>`/`<dd>` pair for one field, absence included as a state. */
  function fieldPair(entry) {
    const name = line("dt", null, entry.name);
    const value = line("dd");
    if (entry.state === "none") {
      // The same rule an absent eval gets: absence renders as absence, in its
      // own words, never as an empty box and never as an error.
      value.append(line("span", "absent", "nothing was sent for this"));
    } else {
      value.append(asTyped(entry.text));
    }
    return [name, value];
  }

  function playedRow(shown) {
    const row = document.createElement("article");
    row.className = "played-row";

    const when = line("h3", "played-when");
    when.append(document.createTextNode("Received "));
    const stamp = document.createElement("time");
    stamp.dateTime = shown.received_at ?? "";
    // The stamp the database wrote, as it wrote it. Not reformatted into the
    // reader's locale: every date this site renders is UTC, and a row's arrival
    // time is a fact about a server clock rather than about where somebody is
    // sitting.
    stamp.textContent = shown.received_at ?? "at a time the answer did not carry";
    when.append(stamp);
    row.append(when);

    // Said again on every record, because a banner at the top of a long list is
    // a banner somebody scrolled past.
    row.append(line(
      "p",
      "unchecked",
      "Your own words, unchecked, not in the corpus, and readable by nobody " +
        "else.",
    ));

    row.append(line("p", "note", `row ${shown.id ?? "the answer carried no id"}`));

    row.append(line(
      "p",
      "note",
      shown.taken_at
        ? `The author read this in on ${shown.taken_at}. Read in means pulled ` +
          "into the corpus file on their machine, which is not the same as " +
          "accepted: there is nothing to accept. It reaches the site when they " +
          "publish the next build."
        : "The author has not read this in yet. That is not a decision about " +
          "it and it is not a place in a line. The row sits in the holding " +
          "table until they pull it, and a pull that refuses it leaves it " +
          "here and writes to you about why.",
    ));

    // Neutral rather than the warning surface. Nothing failed and the reader
    // did nothing wrong: a handle that changed between a sign-in and a send is
    // an ordinary fact about a real person, and `intake.pull` reports it as a
    // note rather than refusing the row. Same rule this page applies to being
    // signed out.
    for (const difference of shown.differs) {
      row.append(line(
        "p",
        "state",
        `The ${difference.field} stamped on this row is ` +
          `${JSON.stringify(difference.stamped)} and the record's own copy ` +
          `says ${JSON.stringify(difference.in_record)}. The stamped one is ` +
          "the one the author reads, because the database wrote it from the " +
          "session and the record carries what this browser thought at the " +
          "time. That is what a handle renamed between signing in and sending " +
          "looks like, and neither copy is dropped.",
      ));
    }

    // One marked region per record. `data-authored` is what the falsifier reads
    // on a published page to tell an author's number from one this registry
    // derived, and everything in here is the first kind.
    const body = document.createElement("div");
    body.className = "played-body";
    body.setAttribute("data-authored", "");

    for (const group of shown.groups) {
      if (!group.entries.length) continue;
      if (group.name) body.append(line("h4", null, group.name));
      const fields = document.createElement("dl");
      fields.className = "played-fields";
      for (const entry of group.entries) fields.append(...fieldPair(entry));
      body.append(fields);
    }

    if (shown.pasted !== null) {
      body.append(line(
        "p",
        "note",
        "This arrived as a paste. It is text and nothing in this browser has " +
          "read it, so there are no fields to show: the one parser is Python " +
          "and it runs when the author pulls the row in.",
      ));
      body.append(line("pre", "played-paste", shown.pasted));
    }

    row.append(body);
    return row;
  }

  function drawPlayed() {
    const list = document.getElementById("played-list");
    if (!list) return;
    list.replaceChildren();
    for (const row of inArrivalOrder(sent, { newestFirst })) {
      list.append(playedRow(playback(row)));
    }
    show("played-none", sent.length === 0);
    show("played-order", sent.length > 1);
    say("played-order-now", newestFirst ? "newest first" : "oldest first");
    for (const button of document.querySelectorAll("#played-order button")) {
      button.setAttribute(
        "aria-pressed",
        String((button.dataset.newest === "true") === newestFirst),
      );
    }
  }

  /** Read them back, renewing first for the same reason the send does. */
  async function readBack(why) {
    if (!SUPABASE || !KEY || !signed) return;
    show("played-said", true);
    say("played-said", why);
    try {
      const now = await usable(SUPABASE, KEY, {
        provider: config.provider,
        held: signed,
        onStale: (problem) => {
          show("stale", true);
          say("stale", staleSaid(problem));
          show("nosession", true);
        },
      });
      signed = now;
      sent = await readPending(SUPABASE, KEY, { accessToken: now.access_token });
      drawPlayed();
      say(
        "played-said",
        sent.length === 0
          ? "This account has sent nothing yet."
          : `This account has sent ${sent.length} ` +
            (sent.length === 1 ? "record" : "records") +
            ", below. None of them is in the corpus.",
      );
    } catch (problem) {
      say(
        "played-said",
        `${problem.message ?? problem} Nothing was changed by this: reading ` +
          "back is a read. Whatever you have sent is still in the holding " +
          "table.",
      );
    }
  }

  function forgetPlayed() {
    sent = [];
    newestFirst = false;
    drawPlayed();
    show("played-said", false);
    show("played-none", false);
  }

  // ------------------------------------------------------------------ //
  // The permission window, for the upload offer and for nothing else.

  async function askPermission() {
    const { verifier, challenge } = await pkcePair();
    sessionStorage.setItem(VERIFIER, verifier);
    const url = authorizeUrl(SUPABASE, {
      provider: config.provider,
      redirectTo: RETURN_TO,
      challenge,
      scopes: WRITE_SCOPES.split(/\s+/).filter(Boolean),
    });
    const child = window.open(url, POPUP_NAME, "width=620,height=760");
    if (!child) {
      throw new Refused(
        "the browser stopped the permission window from opening. Allow popups " +
          "for this site and press the button again. Nothing was sent.",
      );
    }
    return new Promise((resolve, reject) => {
      const done = (event) => {
        if (event.origin !== location.origin || !event.data) return;
        if (event.data.controlbun !== "scope") return;
        window.removeEventListener("message", done);
        clearInterval(watch);
        if (event.data.error) reject(new Refused(event.data.error));
        else if (!event.data.code) {
          reject(new Refused(
            "the permission window came back with no authorization code, so " +
              "there is nothing to exchange and nothing was uploaded.",
          ));
        } else resolve(event.data.code);
      };
      window.addEventListener("message", done);
      const watch = setInterval(() => {
        if (child.closed) {
          clearInterval(watch);
          window.removeEventListener("message", done);
          reject(
            new Refused(
              "the permission window was closed before Hugging Face answered. " +
                "Nothing was sent and nothing was uploaded.",
            ),
          );
        }
      }, 400);
    });
  }

  /** The exchange for the elevated scope, returning only the token. */
  async function elevated(code) {
    const verifier = sessionStorage.getItem(VERIFIER);
    sessionStorage.removeItem(VERIFIER);
    const session = await exchange(SUPABASE, KEY, { code, verifier });
    if (!session.provider_token) {
      throw new Refused(
        "Hugging Face returned a session with no provider token, so there is " +
          "nothing to upload with. Nothing was written to your account.",
      );
    }
    return session.provider_token;
  }

  // ------------------------------------------------------------------ //
  // What the reader typed, or pasted.

  // Whether the registry made the upload on this person's behalf. A fact about
  // how the bytes got where they are, recorded on the submission, and never a
  // property of the submission itself.
  let uploaded = false;

  function readForm() {
    const value = (name) => (document.getElementById(`f-${name}`) || {}).value ?? "";
    const absent = {};
    for (const line of value("absent").split("\n")) {
      const at = line.indexOf(":");
      if (at > 0) absent[line.slice(0, at).trim()] = line.slice(at + 1).trim();
    }
    return {
      label: value("label"),
      version: value("version"),
      created_at: value("created_at"),
      definition: value("definition"),
      intervention_id: value("intervention_id"),
      kind: value("kind"),
      model_id: value("model_id"),
      model_revision: value("model_revision"),
      layer: value("layer"),
      layer_convention: value("layer_convention"),
      hook_point: value("hook_point"),
      chat_template_hash: value("chat_template_hash"),
      activation_norm: value("activation_norm"),
      coeff_low: value("coeff_low"),
      coeff_high: value("coeff_high"),
      steering_position: value("steering_position"),
      license_status: value("license_status"),
      repo: value("repo"),
      commit: value("commit"),
      path: value("path"),
      host: value("host"),
      url_template: value("url_template"),
      absent,
      uploaded_by_registry: uploaded,
    };
  }

  // ------------------------------------------------------------------ //
  // The upload offer, which runs only when somebody presses the button.

  async function publish() {
    const namespace = signer && signer.preferred_username;
    const name = document.getElementById("f-upload-name").value.trim();
    const path = document.getElementById("f-upload-path").value.trim();
    const chosen = document.getElementById("f-upload-file").files[0];
    if (!namespace) throw new Refused("nobody is signed in, so there is no account to publish to.");
    if (!name) throw new Refused("name the repository to create.");
    if (!path) throw new Refused("say where the file goes inside it.");
    if (!chosen) throw new Refused("choose the file.");
    const repo = refuseOurNamespace(`${namespace}/${name}`);

    say("upload-said", "Asking Hugging Face for permission.");
    const code = await askPermission();
    // One variable, one function, one frame. It reaches no file and no log.
    const token = await elevated(code);

    say("upload-said", `Creating ${repo}.`);
    await createRepo(token, { namespace, name });

    const bytes = await chosen.arrayBuffer();
    const oid = await digestOf(bytes);
    say("upload-said", `Sending ${bytes.byteLength} bytes.`);
    const mode = await uploadMode(token, repo, {
      path,
      size: bytes.byteLength,
      sample: btoa(
        String.fromCharCode(...new Uint8Array(bytes.slice(0, 512))),
      ),
    });
    const entry =
      mode === "lfs"
        ? await putLfs(token, repo, { path, bytes, oid })
        : inlineFile(path, bytes);

    const sha = await commit(token, repo, {
      entry,
      summary: "Add a steering direction",
    });
    uploaded = true;
    document.getElementById("f-repo").value = repo;
    document.getElementById("f-commit").value = sha;
    document.getElementById("f-path").value = path;
    say(
      "upload-said",
      `Published to ${repo} at ${sha}. The pin above is filled in. ` +
        "The bytes are in your account and this registry holds none of them.",
    );
  }

  // ------------------------------------------------------------------ //
  // Wiring.

  document.getElementById("copy-prompt").addEventListener("click", async () => {
    const text = document.getElementById("agent-prompt-text").textContent;
    try {
      await navigator.clipboard.writeText(text);
      say(
        "copy-said",
        "Copied. Run it where the extraction happened and paste back what it " +
          "produces.",
      );
    } catch (refused) {
      document.getElementById("prompt-shown").open = true;
      say(
        "copy-said",
        "The clipboard refused, so the prompt is open below instead. Select it " +
          "and copy it by hand.",
      );
    }
  });

  document.getElementById("do-upload").addEventListener("click", () => {
    publish().catch((problem) =>
      say("upload-said", problem.message ?? `${problem}`),
    );
  });

  // A refusal names fields, and the two routes are disclosures, so it can name
  // a field nobody can see. This opens whichever route holds anything typed
  // into it, which is the one the message is about.
  //
  // The `name` attributes come off first when more than one is holding
  // something, because that is the browser's exclusive accordion and it would
  // close each one as the next opened. That case is exactly the refusal for
  // pasting and filling at once, where the reader has to see both to decide
  // which to clear. Nothing typed anywhere opens both for the same reason: the
  // message says neither is filled in, and a closed pair does not show that.
  function revealWhereTheValuesAre() {
    const routes = [...document.querySelectorAll("details[data-route]")];
    const holding = routes.filter((route) =>
      [...route.querySelectorAll("input, textarea")].some(
        (box) => box.type !== "file" && box.value.trim() !== "",
      ),
    );
    const opening = holding.length ? holding : routes;
    if (opening.length > 1) routes.forEach((route) => route.removeAttribute("name"));
    opening.forEach((route) => {
      route.open = true;
    });
  }

  let record = null;
  document.getElementById("build-record").addEventListener("click", () => {
    try {
      const form = readForm();
      const pasted = document.getElementById("f-pasted").value;
      // Which of the two this is, refused when it is both. Neither wins and
      // nothing is dropped: the sentence names what is filled in as well as the
      // paste, so whoever wrote them decides which to clear.
      record =
        chosenRoute(form, pasted) === "paste"
          ? pasteFrom(pasted, { capture: signer, submittedAt: nowStamp() })
          : submissionFrom(form, { capture: signer, submittedAt: nowStamp() });
      document.getElementById("record-json").textContent = JSON.stringify(
        record,
        null,
        2,
      );
      show("record-said", false);
      show("record-out", true);
      // Building again after a send is a new record, so the receipt for the
      // old one comes off the screen rather than sitting under a record it is
      // not a receipt for.
      show("sent", false);
      show("send-said", false);
      document.getElementById("send-record").disabled = false;
    } catch (problem) {
      show("record-out", false);
      revealWhereTheValuesAre();
      // Shown before it is written, in that order: the element carries
      // `role="alert"`, and text set on a node that is not in the
      // accessibility tree yet is text nothing announces.
      show("record-said", true);
      say("record-said", problem.message ?? `${problem}`);
    }
  });

  document.getElementById("keep-record").addEventListener("click", () => {
    if (!record) return;
    download(
      downloadName(
        "submission",
        `${record.author}-${record.label ?? "paste"}`,
        record.submitted_at,
      ),
      JSON.stringify(record, null, 2),
    );
  });

  // The send, which is the path. The download beside it is a copy for the
  // person who made it and is not how anything gets here.
  async function send() {
    if (!SUPABASE || !KEY) {
      throw new Refused(
        "this build was made without an endpoint, so there is nowhere to send " +
          "this. That is a fact about how the site was built rather than about " +
          "your submission, and nothing else here is a way round it: mail is " +
          "not a submission route. Keep the record and try again later.",
      );
    }
    // Renewed first if the access token is spent, which is the ordinary case
    // on a page that has been open a while and on every visit after the first.
    // A person who pressed send should not be told to sign in again for a
    // reason a request could have settled.
    const now = await usable(SUPABASE, KEY, {
      provider: config.provider,
      held: signed,
      onStale: (problem) => {
        show("stale", true);
        say("stale", staleSaid(problem));
        show("nosession", true);
      },
    });
    signed = now;
    // Built from the session and never from the record above, because the
    // database refuses a row whose columns disagree with the session and
    // because a submission that could name its own author would not be worth
    // stamping. The user comes out of the held record rather than the held
    // record going in, so there is still no parameter here a token can reach.
    const row = pendingRowFrom(now.user, record);
    const written = await sendPending(SUPABASE, KEY, {
      accessToken: now.access_token,
      row,
    });
    say("sent-when", written.received_at ?? "the answer carried no time");
    say("sent-id", written.id);
    say("sent-handle", written.handle);
    say("sent-sub", written.subject);
    show("send-said", false);
    show("record-out", false);
    show("sent", true);
    // So the receipt is not the end of it. The row that was just written is
    // read back with everything else this account has sent, out of the table
    // rather than out of what this page happens to be holding.
    await readBack("Reading back what this account has sent, this one included.");
  }

  // The control that reverses the list. Bound here and computing the order in
  // `inArrivalOrder`, which is a pure function a test runs: a bar that renders,
  // sets `aria-pressed` and has nothing behind it shipped once already on the
  // corpus views, and so did one that sorted on something other than what its
  // caption said.
  for (const button of document.querySelectorAll("#played-order button")) {
    button.addEventListener("click", () => {
      newestFirst = button.dataset.newest === "true";
      drawPlayed();
    });
  }

  document.getElementById("send-record").addEventListener("click", (event) => {
    const button = event.currentTarget;
    if (!record) return;
    // Disabled for the length of the request, so a second press is a second
    // row rather than a duplicate of the first one by accident. Re-enabled on
    // failure, because a failure means nothing was written.
    button.disabled = true;
    // Shown first and written second, so the live region has something to
    // announce. It was the other way round, which said it silently.
    show("send-said", true);
    say("send-said", "Sending.");
    send()
      .catch((problem) => {
        button.disabled = false;
        show("send-said", true);
        say("send-said", problem.message ?? `${problem}`);
      });
  });

  arrive().catch(stop);
</script>
