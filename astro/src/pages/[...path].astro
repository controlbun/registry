---
import Base from "../layouts/Base.astro";
import Claimant from "../components/Claimant.astro";
import ArtifactCard from "../components/ArtifactCard.astro";
import Tabs from "../components/Tabs.astro";
import SupportCards from "../components/SupportCards.astro";
import Measurements from "../components/Measurements.astro";
import AttackCards from "../components/AttackCards.astro";
import SubmissionRows from "../components/SubmissionRows.astro";
import Pins from "../components/Pins.astro";
import Relations from "../components/Relations.astro";
import NamespaceClaim from "../components/NamespaceClaim.astro";
import data from "../data/registry.json";

// Everything below the index lives under the model, because an intervention is a
// tensor in one model's basis at one layer and does nothing for another model.
//
//   /models/<model>/                    our reference page for a model
//   /models/<model>/<label>/            everyone claiming that label, there
//   /<owner>/<model>/<label>/<version>/ that owner's submission
//
// Models live under /models/ and not at the root, because a root-level
// /some-org/some-model/ reads as a repository this site hosts. It does not host
// any: a model id here is a reference to somewhere else, and the page is our index
// entry for it.
//
// The shape is also unambiguous, which a root-level model id was not. Owner is the
// first segment and label and version are the last two, so the variable-depth
// model id is always what sits between them. Without that, /alice/gpt2/bar/ was
// both "the model alice/gpt2, label bar" and "owner alice, model gpt2, label bar",
// since model ids are not always org/name: gpt2 and bert-base-uncased are a single
// segment.
//
// Version is in the URL because `author/label@version` is the identity in this
// schema and nothing above it resolves to one artifact. Without it the route
// assumed one submission per author per label, which held only while nobody had
// published two takes on their own word. Three estimators over one contrast set
// are three submissions, and collapsing them to a URL would have picked one.
//
// `owner` is whoever published the submission and may be a person or an org.
//
// A label has no page of its own. Claimants of the same word on different models
// are not comparable: the angle between their vectors is undefined and their evals
// are not commensurable. Putting them in one table would have been a view of
// nothing. The plurality worth rendering is several people meaning different
// things by one word against one model, where the disagreement is real.
//
// Model ids keep their slash, so the route is a catch-all and the depth of a model
// id is not something this file needs to know.
export function getStaticPaths() {
  const routes = [];

  for (const model of data.model_index) {
    routes.push({
      params: { path: `models/${model.model_id}` },
      props: { view: "model", model, block: null, claimant: null },
    });

    for (const block of model.labels) {
      routes.push({
        params: { path: `models/${model.model_id}/${block.label}` },
        props: { view: "label", model, block, claimant: null },
      });

      for (const claimant of block.claimants) {
        routes.push({
          params: {
            path: `${claimant.author}/${model.model_id}/${block.label}/${claimant.version}`,
          },
          props: { view: "submission", model, block, claimant },
        });
      }
    }
  }

  for (const owner of data.owner_index) {
    routes.push({
      params: { path: owner.owner },
      props: { view: "owner", model: null, block: null, claimant: null, owner },
    });
  }

  return routes;
}

const { view, model, block, claimant, owner } = Astro.props;

// Built once, sliced per view, so a segment can never link somewhere its text
// does not describe.
const crumbs = {
  registry: { text: "controlbun", href: "/" },
  models: { text: "Models", href: "/models/" },
  owners: { text: "Owners", href: "/owners/" },
  model: model ? { text: model.model_id, href: `/models/${model.model_id}/` } : null,
  label: model && block
    ? { text: block.label, href: `/models/${model.model_id}/${block.label}/` }
    : null,
};

// Pins of exactly this submission, keyed on all four identity columns. Keyed
// on three, a pin of one model's artifact showed up on another model's page
// the moment one author claimed one label on two models.
const pinsHere = claimant
  ? data.pins.filter(
      (p) => p.author === claimant.author && p.model_id === claimant.model_id
             && p.label === claimant.label && p.version === claimant.version)
  : [];

const released = (iso) =>
  new Date(iso).toLocaleDateString("en-US", {
    year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

{view === "model" && (
  <Base
    title={`${model.model_id} — interventions`}
    trail={[crumbs.registry, crumbs.models]}
    synthetic={model.synthetic}
    ordering
  >
    <h1 slot="heading" class="mono">{model.model_id}</h1>

    <p class="lede">
      Every intervention published against this model. This registry does not host
      the model and has no claim on it; the id is a reference to wherever it lives.
      Artifacts do not carry over between models, so this page is the unit that
      composes: angle similarity is only meaningful here, inside one model at one
      layer and hook point.
    </p>

    <div class="scope">
      <div><span class="k">Artifacts</span>{model.claimant_count}</div>
      <div><span class="k">Labels claimed</span>{model.label_count}</div>
      <div><span class="k">Kinds</span><span class="mono">{model.kinds.join(", ")}</span></div>
      <div><span class="k">Hook points</span><span class="mono">{model.hook_points.join(", ")}</span></div>
      <div><span class="k">Layers</span>{model.layers.join(", ")}</div>
      <div>
        <span class="k">Revisions pinned</span>
        {/* A null revision is nobody recording one, which is a different fact
            from a revision nobody pinned, so it reads as its own state rather
            than as a blank cell. See schema/migrations/005. */}
        <span class="mono">
          {model.revisions.every((r) => r === null)
            ? <span class="absent">none recorded</span>
            : model.revisions
                .map((r) => (r === null ? "not recorded" : r.slice(0, 12)))
                .join(", ")}
        </span>
      </div>
    </div>

    <div data-pagefind-body>
      <p class="note" data-pagefind-filter="model">
        Base and instruct are different models, and so is a different revision.
        Each artifact names the revision it was extracted against.
      </p>

      <table class="labels">
        <thead>
          <tr>
            <th><button data-col="0">Label</button></th>
            <th><button data-col="1">Claimants</button></th>
          </tr>
        </thead>
        <tbody data-orderable>
          {model.labels.map((b) => (
            <tr data-created={b.latest} data-engagement={b.engagement}>
              <td><a href={`/models/${model.model_id}/${b.label}/`}>{b.label}</a></td>
              <td>{b.claimants.length}</td>
            </tr>
          ))}
        </tbody>
      </table>

    </div>
  </Base>
)}

{view === "label" && (
  <Base
    title={`${block.label} on ${model.model_id}`}
    trail={[crumbs.registry, crumbs.models, crumbs.model]}
    synthetic={block.synthetic}
    ordering
  >
    <h1 slot="heading">{block.label}</h1>

    <p class="lede">
      Everyone claiming <strong>{block.label}</strong> against
      {" "}<a class="mono" href={`/models/${model.model_id}/`}>{model.model_id}</a>.
      Computed on demand and owned by nobody: this does not resolve to an artifact.
      {" "}{block.claimants.length} claimant{block.claimants.length === 1 ? "" : "s"}.
    </p>

    <div data-pagefind-body>
      <SubmissionRows
        claimants={block.claimants}
        modelId={model.model_id}
        similarity={data.labels.find((l) => l.label === block.label).similarity}
      />

      <h2>How the claimants read each other</h2>
      <Relations
        relations={data.relations.filter((r) => r.from_label === block.label)}
        label={block.label}
      />

      <h2>Who has pinned one of these</h2>
      {/* Scoped to this model, because the page is one label on one model.
          A pin of the same word against another model is a pin of another
          artifact, and showing it here would read as somebody having pinned
          one of the rows above. */}
      <Pins
        pins={data.pins.filter(
          (p) => p.label === block.label && p.model_id === model.model_id)}
        subject={`A pinned ${block.label} on ${model.model_id}`}
      />
    </div>
  </Base>
)}

{view === "submission" && (
  <Base
    title={`${claimant.ref}`}
    trail={[crumbs.registry, crumbs.models, crumbs.model, crumbs.label]}
    synthetic={claimant.is_synthetic ? "all" : "none"}
  >
    {/* The four-part reference, which is the identity. Off the payload
        rather than composed here: `registry/views.py` builds it through the
        module that owns the format. */}
    <h1 slot="heading" class="mono">{claimant.ref}</h1>

    <p class="lede">
      One owner's complete take on <strong>{block.label}</strong>, against
      {" "}<a class="mono" href={`/models/${model.model_id}/`}>{model.model_id}</a>.
      Self-contained and internally consistent. It does not have to agree with
      {" "}<a href={`/models/${model.model_id}/${block.label}/`}>anyone else claiming the
      same word</a>, and the registry does not ask it to.
    </p>

    <Tabs tabs={[
      { id: "artifact", label: "Artifact", count: null },
      { id: "support", label: "Support cards", count: claimant.support.length },
      { id: "measurements", label: "Independent measurements",
        count: claimant.verifications.length },
      { id: "attacks", label: "Attack cards", count: claimant.attacks.length },
      { id: "pins", label: "Pins", count: pinsHere.length },
      { id: "comments", label: "Comments", count: null },
    ]} />

    <div data-pagefind-body>
      <div data-panel="artifact">
        <ArtifactCard claimant={claimant} modelId={model.model_id} />
      </div>

      <div data-panel="support" class="hidden">
        <SupportCards support={claimant.support} author={claimant.author} />
      </div>

      <div data-panel="measurements" class="hidden">
        <Measurements
          measurements={claimant.verifications}
          author={claimant.author}
          own={{
            trait: claimant.trait_score,
            coherence: claimant.coherence_score,
            state: claimant.score_state,
          }}
        />
      </div>

      <div data-panel="attacks" class="hidden">
        <AttackCards attacks={claimant.attacks} author={claimant.author} />
      </div>

      <div data-panel="pins" class="hidden">
        <Pins
          pins={pinsHere}
          subject={claimant.ref}
        />
      </div>

      <div data-panel="comments" class="hidden">
        <p class="note absent-block">
          No comments, and no way to leave one. Comments need a write path and an
          account behind it, and this build has neither.
        </p>
      </div>
    </div>
  </Base>
)}

{view === "owner" && (
  <Base
    title={`${owner.owner}`}
    trail={[crumbs.registry, crumbs.owners]}
    synthetic={owner.synthetic}
    ordering={owner.submissions.length > 0}
  >
    <h1 slot="heading" class="mono">{owner.owner}</h1>

    <p class="lede">
      Everything {owner.owner} has done here. Publishing an artifact is one way to
      take part and not the only one: evaluating somebody else's submission,
      attacking it, and reporting what happened when you used it are the rest, and
      they are what makes anything here evidence rather than a file.
    </p>

    <div class="scope">
      <div><span class="k">Submissions</span>{owner.submissions.length}</div>
      <div>
        <span class="k">Labels claimed</span>
        {owner.labels.length
          ? owner.labels.join(", ")
          : <span class="absent">none</span>}
      </div>
      <div>
        <span class="k">Kinds</span>
        {owner.kinds.length
          ? <span class="mono">{owner.kinds.join(", ")}</span>
          : <span class="absent">none</span>}
      </div>
      <div><span class="k">Attacks received</span>{owner.attacks_received}</div>
    </div>

    <div data-pagefind-body>
      {/* The namespace and whoever has claimed it. Here, on the namespace's own
          page, and nowhere else: a claim shown beside other people's in a list
          reads as a rank, which is the erosion this project is most alert to.
          See NamespaceClaim.astro. */}
      <h2>Namespace</h2>
      <NamespaceClaim namespace={owner.owner} claims={owner.claims} />

      <h2>Submissions</h2>
      {owner.submissions.length === 0 && (
        <p class="note absent-block">
          {owner.owner} has not published an artifact. What is below is their work
          on other people's.
        </p>
      )}
      {owner.submissions.length > 0 && (
      <table class="submissions">
        <thead>
          <tr>
            <th><button data-col="0">Label</button></th>
            <th><button data-col="1">Model</button></th>
            <th>Released</th>
            <th>Evidence</th>
          </tr>
        </thead>
        <tbody data-orderable>
          {owner.submissions.map((s) => (
            <tr data-created={s.created_at} data-engagement={s.engagement}>
              <td>
                <a href={`/${owner.owner}/${s.model_id}/${s.label}/${s.version}/`}
                   title={s.ref}>
                  {s.label}<span class="meta">@{s.version}</span>
                </a>
                <div class="provenance mono">{s.kind} @{s.version}</div>
              </td>
              <td class="mono">
                <a href={`/models/${s.model_id}/`}>{s.model_id}</a>
              </td>
              <td><time datetime={s.created_at}>{released(s.created_at)}</time></td>
              <td class="provenance">
                {s.score_state === "uninterpretable"
                  ? <span class="uninterpretable">score uninterpretable</span>
                  : s.score_state === "absent"
                    ? <span class="absent">no score</span>
                    : "score reported"}
                {", "}
                {s.has_recipe ? "recipe" : <span class="absent">no recipe</span>}
                {", "}
                {s.attacks
                  ? `${s.attacks} attack${s.attacks === 1 ? "" : "s"}`
                  : <span class="absent">never attacked</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      )}


      <h2>Work on other people's submissions</h2>

      {owner.evaluations.length === 0 && owner.attacks_made.length === 0
        && owner.support_given.length === 0 ? (
        <p class="note absent-block">
          {owner.owner} has not evaluated, attacked or reported use of anybody
          else's submission. Nothing follows from that about the quality of their
          own work. It does mean every number on their submissions was measured by
          the person who made them.
        </p>
      ) : (
        <>
          {owner.attacks_made.length > 0 && (
            <>
              <h3>Attacks</h3>
              <table>
                <thead>
                  <tr><th>Against</th><th>Method</th><th>Attacker calls it</th><th>When</th></tr>
                </thead>
                <tbody>
                  {owner.attacks_made.map((a) => (
                    <tr>
                      <td>
                        <a class="mono" href={a.model_id
                          ? `/${a.subject_author}/${a.model_id}/${a.label}/${a.version}/`
                          : `/${a.subject_author}/`}>{a.subject}</a>
                      </td>
                      <td class="mono">{a.method}</td>
                      <td>{(a.disposition || "").replace(/-/g, " ")}</td>
                      <td class="provenance">
                        <time datetime={a.attacked_at}>{released(a.attacked_at)}</time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                Both dispositions are shown on the artifact's own page, where the
                author answers it. What is here is only that the attack was made.
              </p>
            </>
          )}

          {owner.evaluations.length > 0 && (
            <>
              <h3>Independent measurements</h3>
              <table>
                <thead>
                  <tr><th>Measured</th><th>Reported</th></tr>
                </thead>
                <tbody>
                  {owner.evaluations.map((e) => (
                    <tr>
                      <td>
                        <a class="mono" href={e.model_id
                          ? `/${e.subject_author}/${e.model_id}/${e.label}/${e.version}/`
                          : `/${e.subject_author}/`}>{e.subject}</a>
                      </td>
                      <td class="provenance">
                        <time datetime={e.reported_at}>{released(e.reported_at)}</time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="note">
                Somebody other than the author ran their own suite against this
                work. The scores are on the artifact's page.
              </p>
            </>
          )}

          {owner.support_given.length > 0 && (
            <>
              <h3>Applied use</h3>
              <table>
                <thead>
                  <tr><th>Used</th><th>For</th><th>Behaved</th><th>Reported</th></tr>
                </thead>
                <tbody>
                  {owner.support_given.map((c) => (
                    <tr>
                      <td>
                        <a class="mono" href={c.model_id
                          ? `/${c.subject_author}/${c.model_id}/${c.label}/${c.version}/`
                          : `/${c.subject_author}/`}>{c.subject}</a>
                      </td>
                      <td>{c.purpose}</td>
                      <td>
                        {c.predictability
                          ? c.predictability.replace(/-/g, " ")
                          : <span class="absent">not reported</span>}
                      </td>
                      <td class="provenance">
                        <time datetime={c.reported_at}>{released(c.reported_at)}</time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </>
      )}

      <h2>Eval suites</h2>
      {owner.suites.length === 0 ? (
        <p class="note absent-block">
          {owner.owner} has not published an eval suite. A suite is what lets
          somebody measure other people's submissions on stated terms, so its
          absence is why nothing above could be a measurement of anyone else.
        </p>
      ) : (
        <>
          <table>
            <thead>
              <tr><th>Suite</th><th>Judge</th><th>Confound axes checked</th></tr>
            </thead>
            <tbody>
              {owner.suites.map((x) => (
                <tr>
                  <td class="mono">{x.suite}</td>
                  <td class="mono">
                    {x.judge_model
                      ? <>{x.judge_model}@{x.judge_revision}</>
                      : <span class="absent">no judge pinned</span>}
                  </td>
                  <td>
                    {x.axes.length
                      ? x.axes.join(", ")
                      : <span class="absent">none stated</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">
            The judge model and revision are pinned by the suite's author for their
            own measurements. A score from a different judge is a different
            measurement, which is why suites are named rather than pooled.
          </p>
        </>
      )}
    </div>
  </Base>
)}
