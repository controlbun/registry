---
import "../styles/app.css";
import data from "../data/registry.json";

// The home page: what this is in the middle, the ways in on the left, what
// arrived recently on the right.
//
// PROSE IS PLACEHOLDER. The sentences in the middle column are lifted from
// BRIEF.md so the page says something true in the author's own words rather than
// in mine. Replace them before anyone outside sees this.

const recent = data.model_index
  .flatMap((m) => m.submissions)
  .slice()
  .sort((a, b) => b.created_at.localeCompare(a.created_at))
  .slice(0, 8);

const released = (iso) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric" });

const belowThreshold = data.corpus.size < data.corpus.threshold;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registry</title>
    <script is:inline>
      // Applied before paint, so a reader who picked a theme never sees a flash
      // of the other one.
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <div class="home">
      <nav class="sidenav">
        <h3>Browse</h3>
        <a href="/models/">Models</a>
        <a href="/owners/">Owners</a>

        <h3>Account</h3>
        <span class="soon">Profile</span>
        <span class="soon">Submissions</span>
        <span class="soon">Settings</span>

        <h3>Resources</h3>
        <span class="soon">Getting started</span>
        <span class="soon">Documentation</span>
        <span class="soon">Publishing a submission</span>

        <button class="themetoggle" type="button" id="theme">Dark theme</button>
      </nav>

      <main class="intro">
        <h1>Registry</h1>

        <p class="lede">
          A registry for activation-steering artifacts, in the spirit of GitHub or
          Hugging Face rather than a curated database.
        </p>

        <h2>A vector is not portable, but a recipe is</h2>
        <p>
          A steering vector is a tensor in one model's residual basis at one layer,
          so a <span class="mono">kindness</span> vector for one model does nothing
          for another. What travels is the extraction recipe: the contrast data, the
          author's definition of the trait, the layer sweep, the evaluation.
        </p>

        <h2>Plurality is the product</h2>
        <p>
          Ten people will extract <span class="mono">kindness</span> with different
          contrast data, different theories of what kindness is, and different ideas
          about what could be confounding it. The registry holds all ten side by
          side and makes the disagreement legible. It does not pick a winner,
          mandate a definition, or impose a single evaluation.
        </p>

        <p class="pull">
          The primary object is a submission: one author's complete take,
          self-contained, comparable to others after the fact rather than conformant
          to them in advance.
        </p>

        <h2>What you will see on a page</h2>
        <p>
          A trait score always appears with a coherence measure beside it, or it
          appears as uninterpretable rather than as a number. Anything an author did
          not measure reads as not measured, never as zero. Angle similarity between
          two artifacts is shown as geometry, never as evidence that two authors
          disagree. Nothing is ranked by a measured result.
        </p>

        <p class="note">
          Copy on this page is placeholder, drawn from BRIEF.md.
        </p>
      </main>

      <aside class="rail">
        <div class="panel">
          <h3>{belowThreshold ? "Recently added" : "Trending"}</h3>
          <ol>
            {recent.map((s) => (
              <li>
                <a href={`/${s.author}/${s.model_id}/${s.label}/`}>
                  {s.author}/{s.label}
                </a>
                <span class="meta mono">{s.kind} · {s.model_id}</span>
                <span class="meta">{released(s.created_at)}</span>
              </li>
            ))}
          </ol>
          <p class="why">
            {belowThreshold
              ? `${data.corpus.size} submissions, under the ${data.corpus.threshold} needed before engagement means anything. Newest first until then: there is nothing to trend on yet, and an invented ranking would be worse than none.`
              : "Evaluations and attacks by people other than the author, decayed by age. Never a measured score, and not downloads."}
          </p>
        </div>
      </aside>
    </div>

    <script>
      const button = document.querySelector("#theme");
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

      const isDark = () =>
        (root.dataset.theme || (prefersDark ? "dark" : "light")) === "dark";
      const label = () => {
        button.textContent = isDark() ? "Light theme" : "Dark theme";
      };
      label();

      button.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
        label();
      });
    </script>
  </body>
</html>
