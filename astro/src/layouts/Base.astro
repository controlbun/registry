---
import "../styles/app.css";
import Head from "../components/Head.astro";
import SiteNav from "../components/SiteNav.astro";
import data from "../data/controlbun.json";

interface Props {
  title: string;
  // Every level above this page, outermost first. Each entry links to where its
  // text says it goes: a crumb reading "Models" that lands on the home page is
  // worse than no crumb, because the reader stops checking.
  trail?: { text: string; href: string }[];
  // Opt-in, and false by default. The ordering control belongs only on a page
  // that shows a list; on a single artifact there is nothing to order, and a
  // control that reorders nothing is noise that implies the page is a view of
  // many things when it is a view of one.
  ordering?: boolean;
  // What this page actually shows. The marker used to be one corpus-wide flag,
  // which was honest while everything was a fixture and became a lie the moment
  // one submission was not: it told a reader that a real measurement was
  // invented. The page passes what is on it and the banner describes that.
  //
  //   "all"   every figure here is fabricated
  //   "mixed" some are, and the exception is named
  //   "none"  nothing here is, so no marker at all
  synthetic?: "all" | "mixed" | "none";
}
const { title, trail = [], ordering = false, synthetic = "all" } = Astro.props;
const corpus = data.corpus;

// "soham's" for one, "soham's and rae's" for two, commas past that. Built from
// the data rather than written down, so the exception cannot outlive the rows.
const owned = (data.real_authors ?? []).map((n) => n + "'s");
const exception =
  owned.length === 0
    ? ""
    : owned.length === 1
      ? owned[0]
      : owned.slice(0, -1).join(", ") + " and " + owned[owned.length - 1];
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body>
    <SiteNav />

    <main>
      {trail.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {trail.map((step, i) => (
            <>
              {i > 0 && <span class="sep">/</span>}
              <a href={step.href}>{step.text}</a>
            </>
          ))}
        </nav>
      )}

      <slot name="heading" />

      {data.any_synthetic && synthetic !== "none" && (
        <div class="banner">
          <strong>Synthetic corpus{synthetic === "mixed" && exception
            ? `, except ${exception}`
            : ""}.</strong>{" "}
          {synthetic === "mixed" && exception
            ? `Every figure here is fabricated to exercise the interface apart from ${exception}, which is real. Fabricated scores are repeated-digit decimals, fabricated vectors are integer ramps, and the models those name do not resolve.`
            : "Every figure here is fabricated to exercise the interface. Scores are repeated-digit decimals, vectors are integer ramps, and the models named do not resolve. Nothing on this page is a measurement."}
        </div>
      )}

      {ordering && (
      <div class="ordering">
        <span>Ordered by <strong>{corpus.active_order_name}</strong>.</span>
        {corpus.order_choices.map((choice) => (
          <button
            type="button"
            data-order-key={choice.key}
            aria-pressed={choice.key === corpus.active_order}
          >
            {choice.name}
          </button>
        ))}
        {/* One clause, because this sits above the content on every list page.

            It was two sentences. A stranger reading the site cold hit it on
            three pages running and said that by the third they were scrolling
            past the top of pages without reading, which is a habit that then
            costs everything else that ever goes there.

            The number went for a different reason. It read "under the 100 at
            which engagement starts to mean anything", and 100 is a threshold
            somebody chose rather than one anything derives: order.py says only
            that below it "engagement data is too thin to mean anything". Naming
            it gave the reader a figure they could not interpret and a question
            with no answer. The corpus size is a fact and stays.

            Also gone: "It is a starting point you can change, not a verdict."
            The control is right there and says what it does. That sentence is
            the site arguing with an objection nobody raised, which is the
            category already cut everywhere else and survived here. */}
        <span class="why">
          {corpus.size < corpus.threshold
            ? `${corpus.size} submissions is too few for engagement to mean anything, so this is newest-first.`
            : "Trending weighs evaluations and attacks by people other than the author, decayed by age. Not a measured result and not downloads."}
        </span>
      </div>
      )}

      <slot />
    </main>
  </body>
</html>

<script define:vars={{ corpus }}>
  // The ordering control shipped for days with no handler: the buttons rendered,
  // aria-pressed was set, and clicking did nothing. It looked finished, which is
  // the worst failure mode a control has.
  //
  // The contract is markup-shaped rather than table-shaped, so it holds for a list
  // that is not a table: `data-orderable` marks whatever element directly holds
  // the items, and each child carries the two inputs order.py uses. Every such
  // container on the page is bound, not the first one, so a page that grows a
  // second list does not end up with a control that silently drives half of what
  // the reader is looking at.
  const bar = document.querySelector(".ordering");
  const lists = [...document.querySelectorAll("[data-orderable]")];

  if (bar && lists.length) {
    const now = Date.now();
    const finite = (v) => (Number.isFinite(v) ? v : 0);
    const created = (el) => finite(Date.parse(el.dataset.created));

    const keyOf = {
      "recently-added": created,
      // order.trending_score, ported. The constants ride along in the payload
      // instead of being retyped here, because two copies of a ranking function
      // drift and the page would then describe an ordering it does not compute.
      // Engagement plus one, so an untouched submission still decays purely with
      // age rather than flattening into a tie.
      trending: (el) => {
        const hours = Math.max((now - created(el)) / 3600000, 0);
        return (finite(Number(el.dataset.engagement)) + 1) /
          Math.pow(hours + corpus.age_offset_hours, corpus.gravity);
      },
    };

    // Captured before any reorder, so an unrecognized key falls back to what the
    // exporter emitted. Same disposition as apply_order: an ordering this build
    // does not implement is a request it cannot serve, not an error in the data.
    const stored = lists.map((list) => [list, [...list.children]]);
    const buttons = [...bar.querySelectorAll("[data-order-key]")];

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const score = keyOf[button.dataset.orderKey];

        stored.forEach(([list, original]) => {
          const items = score
            // Descending, and ties keep storage order: two things released the
            // same day are not ranked against each other by an accident of sort
            // implementation.
            ? original
                .map((el, i) => [el, i])
                .sort((a, b) => score(b[0]) - score(a[0]) || a[1] - b[1])
                .map(([el]) => el)
            : [...original];
          items.forEach((el) => list.appendChild(el));
        });

        // The sentence above the buttons names the ordering. Leaving it on the
        // server-rendered value meant the page said one thing and showed another
        // the moment the reader clicked, which is the same dishonesty as the dead
        // control in a quieter form.
        const named = bar.querySelector("strong");
        if (named) named.textContent = button.textContent.trim();

        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
      });
    });
  }
</script>
