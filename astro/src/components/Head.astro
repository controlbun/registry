---
// Everything inside <head>, in one place.
//
// There were two heads: Base.astro for every page, and index.astro which builds
// its own document because the home page has a different column layout. They
// drifted, and the drift was not cosmetic. The script that reads the reader's
// saved theme lived only on the home page, so someone could switch to light,
// click through to /models/, and land back in dark. The preference was written
// and then never read anywhere else.
//
// Same shape as the two frontends that were retired: a second copy of something
// that has to stay in step, and no mechanism keeping it there. A component is
// that mechanism.
interface Props {
  title: string;
}
const { title } = Astro.props;

// One description for every page, and it is the lede the author already wrote
// rather than a second sentence saying the same thing differently. Two copies of
// the project's one-line description would drift the way the two heads did.
const DESCRIPTION =
  "A registry for activation-steering artifacts, in the spirit of GitHub or " +
  "Hugging Face rather than a curated database.";

// Absolute, from `site` in astro.config.mjs. A relative canonical is not a
// canonical, and a preview card built from a relative URL resolves against
// whatever host rendered it.
//
// Named `pageUrl` and not `canonical` because the invariant scanner flags that
// word used as an identifier, and it is right to: the registry designating one
// artifact as the canonical one is the failure this project is built around.
// The `rel="canonical"` attribute below is the HTML standard and stays. Second
// time this week, after `canonicalize` became `sort_header`.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={DESCRIPTION} />
<link rel="canonical" href={pageUrl} />

{/*
  Link previews. Not vanity: this site will mostly be encountered as a URL
  somebody pasted into Slack or a message, and an unfurled card is the only part
  of it many people will ever read. A bare URL there says nothing at all.
*/}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="controlbun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={DESCRIPTION} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={new URL("/icon-512.png", Astro.site)} />
<meta name="twitter:card" content="summary" />

<script is:inline>
  // Applied before paint, so a reader who picked a theme never sees a flash of
  // the other one. Inline and unbundled on purpose: a deferred module would run
  // after first paint, which is the flash this exists to prevent.
  const saved = localStorage.getItem("theme");
  if (saved) document.documentElement.dataset.theme = saved;

  // The bar at the top ships both ways in, and which one is wrong depends on a
  // fact no build can know. Decided here for the same reason the theme is:
  // anything that runs after first paint shows the wrong one for a frame.
  //
  // One key, and what is in it is the session this registry's identity service
  // issued to `/signed-in/` at the exchange, with the account id, the subject
  // and the handle it was issued for. The handle is the only part read here.
  //
  // The service is not named in this comment on purpose. This script is inline,
  // so it ships on every page, and `tests/test_signed_in_page.py` refuses the
  // provider's name and its endpoint on every page but the one with business
  // for them. A comment is not an endpoint and the guard cannot tell, which is
  // the right way round: the cheap fix is here and the guard stays strict.
  //
  // **Add artifact is offered only when that record carries a refresh token**,
  // because that is what makes it a way in rather than a name. This key
  // replaced one that held a handle and nothing else, and the bar on top of it
  // said Add artifact to somebody whose session had been gone since their last
  // reload. Nothing on any page contributes to this, which is the other half of
  // the point: a bar that read an author's name off the page it is sitting on
  // would say a reader is somebody because they were looking at that person's
  // submission.
  try {
    const held = JSON.parse(localStorage.getItem("controlbun.session") || "null");
    const said = held && held.user && held.user.user_metadata;
    if (held && held.refresh_token && said && said.preferred_username) {
      document.documentElement.dataset.who = said.preferred_username;
    }
  } catch (unreadable) {
    // A key this build cannot parse is one an older build wrote or one
    // something else corrupted. Dropping it is the whole repair: what is lost
    // is a session the reader can replace by signing in again.
    localStorage.removeItem("controlbun.session");
  }
  // The key that held a handle and no session. An older build wrote it, and a
  // browser that still carries one would otherwise keep it forever, since
  // nothing reads it now. Removed rather than read: it is the thing this change
  // was made to stop offering.
  localStorage.removeItem("controlbun.who");
</script>

{/*
  One set, not two. The mark now carries a real alpha channel, and the outlined
  version reads on white, on near-black and on mid gray, because the outline draws
  every edge regardless of what is behind it. Before it was opaque artwork, so a
  single file was a white tile in dark browser chrome, which is what the two
  media-switched sets existed to work around.
*/}
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
