---
// Everything inside <head>, in one place.
//
// There were two heads: Base.astro for every page, and index.astro which builds
// its own document because the home page has a different column layout. They
// drifted, and the drift was not cosmetic. The script that reads the reader's
// saved theme lived only on the home page, so someone could switch to light,
// click through to /models/, and land back in dark. The preference was written
// and then never read anywhere else.
//
// Same shape as the two frontends that were retired: a second copy of something
// that has to stay in step, and no mechanism keeping it there. A component is
// that mechanism.
interface Props {
  title: string;
}
const { title } = Astro.props;

// One description for every page, and it is the lede the author already wrote
// rather than a second sentence saying the same thing differently. Two copies of
// the project's one-line description would drift the way the two heads did.
const DESCRIPTION =
  "A registry for activation-steering artifacts, in the spirit of GitHub or " +
  "Hugging Face rather than a curated database.";

// Absolute, from `site` in astro.config.mjs. A relative canonical is not a
// canonical, and a preview card built from a relative URL resolves against
// whatever host rendered it.
//
// Named `pageUrl` and not `canonical` because the invariant scanner flags that
// word used as an identifier, and it is right to: the registry designating one
// artifact as the canonical one is the failure this project is built around.
// The `rel="canonical"` attribute below is the HTML standard and stays. Second
// time this week, after `canonicalize` became `sort_header`.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={DESCRIPTION} />
<link rel="canonical" href={pageUrl} />

{/*
  Link previews. Not vanity: this site will mostly be encountered as a URL
  somebody pasted into Slack or a message, and an unfurled card is the only part
  of it many people will ever read. A bare URL there says nothing at all.
*/}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="controlbun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={DESCRIPTION} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={new URL("/icon-512.png", Astro.site)} />
<meta name="twitter:card" content="summary" />

<script is:inline>
  // Applied before paint, so a reader who picked a theme never sees a flash of
  // the other one. Inline and unbundled on purpose: a deferred module would run
  // after first paint, which is the flash this exists to prevent.
  const saved = localStorage.getItem("theme");
  if (saved) document.documentElement.dataset.theme = saved;
</script>

{/*
  One set, not two. The mark now carries a real alpha channel, and the outlined
  version reads on white, on near-black and on mid gray, because the outline draws
  every edge regardless of what is behind it. Before it was opaque artwork, so a
  single file was a white tile in dark browser chrome, which is what the two
  media-switched sets existed to work around.
*/}
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
