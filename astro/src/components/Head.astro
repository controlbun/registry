---
// Everything inside <head>, in one place.
//
// There were two heads: Base.astro for every page, and index.astro which builds
// its own document because the home page has a different column layout. They
// drifted, and the drift was not cosmetic. The script that reads the reader's
// saved theme lived only on the home page, so someone could switch to light,
// click through to /models/, and land back in dark. The preference was written
// and then never read anywhere else.
//
// Same shape as the two frontends that were retired: a second copy of something
// that has to stay in step, and no mechanism keeping it there. A component is
// that mechanism.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>

<script is:inline>
  // Applied before paint, so a reader who picked a theme never sees a flash of
  // the other one. Inline and unbundled on purpose: a deferred module would run
  // after first paint, which is the flash this exists to prevent.
  const saved = localStorage.getItem("theme");
  if (saved) document.documentElement.dataset.theme = saved;
</script>

{/*
  Two icons because the artwork carries an opaque background rather than an alpha
  channel, so the light one is a white tile in dark browser chrome and the dark one
  is a black tile in light chrome. The media attribute picks correctly where it is
  honored; the unqualified link after them is the fallback for browsers that ignore
  it, and it points at the dark mark because dark is the default everywhere else
  here.
*/}
<link rel="icon" type="image/png" sizes="32x32"
      href="/icon-light-32.png" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/png" sizes="16x16"
      href="/icon-light-16.png" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/png" sizes="32x32"
      href="/icon-dark-32.png" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="16x16"
      href="/icon-dark-16.png" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="32x32" href="/icon-dark-32.png" />

<link rel="apple-touch-icon" sizes="180x180" href="/icon-dark-180.png" />
