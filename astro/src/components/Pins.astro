---
import Prose from "./Prose.astro";
// Who has frozen this submission, for what, and what they passed over.
//
// This is the distinction the whole project rests on. The registry never
// designates: it does not assert that one entry is the right one. A consumer
// pins: it freezes one `author/label@version` for one purpose so its own numbers
// stay comparable, which is ordinary experimental control and is required rather
// than merely tolerated.
//
// The difference is entirely visibility. A pin that is named, dated and shown
// beside what it was chosen over is a choice a reader can contest. The same pin
// with its alternatives hidden reads as the answer, and has become a designation
// without anyone deciding to make one. So the alternatives are not an optional
// detail here; they are the thing that keeps this legitimate.
interface Props {
  pins: any[];
  subject: string;
}
const { pins, subject } = Astro.props;

const when = (iso) =>
  new Date(iso).toLocaleDateString("en-US", {
    year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

{pins.length === 0 ? (
  <p class="note absent-block">
    Nobody has pinned this.
  </p>
) : (
  pins.map((p) => (
    <div class="pin">
      <div class="provenance">
        <strong>{p.pinned_by}</strong> pinned
        {" "}<span class="mono">{p.target}</span> on {when(p.pinned_at)}
      </div>
      <Prose text={p.purpose} class="definition" />
      {p.rationale && <p class="note">{p.rationale}</p>}

      <div class="passed-over">
        <span class="k">Passed over</span>
        {p.alternatives.length === 0 ? (
          <span class="uninterpretable">
            nothing recorded, so this pin cannot be contested
          </span>
        ) : (
          <ul>
            {p.alternatives.map((alt) => <li class="mono">{alt}</li>)}
          </ul>
        )}
      </div>
    </div>
  ))
)}


