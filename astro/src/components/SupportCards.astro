---
// Support cards: someone used this artifact in their own work and reports whether
// it behaved the way the published contract said it would.
//
// Not an evaluation. An eval re-measures the artifact against a benchmark; this
// reports applied use, which is the only evidence here that touches external
// validity. "I used it for something real and it did what it claimed" is a
// different statement from "your number reproduces", and nothing else in the
// schema carries it.
//
// It is also the only evidence that tests the application contract rather than
// the artifact. A vector applied at the wrong layer or hook point does not fail
// loudly, it appears not to work, so a reader who cannot make it behave has no
// way to tell a bad artifact from bad metadata. `deviations` is where that gets
// said, and it is a defect report about us rather than about the author.
//
// Why each card leads with a prediction: user ratings were rejected here because
// a direction that also moves sentiment and verbosity feels more effective in
// use, since more is happening, while a well-isolated one feels subtler. So
// satisfaction favors the confounded artifact. A card that records what was
// expected and what happened is evidence; one that records how it felt is a star
// rating with more words.
interface Props {
  support: any[];
  author: string;
}
const { support, author } = Astro.props;

const when = (iso) =>
  new Date(iso).toLocaleDateString("en-US", {
    year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

{support.length === 0 ? (
  <p class="note absent-block">
    No support cards. Nobody has reported using this artifact in their own work.
  </p>
) : (
  support.map((s) => (
    <div class={s.deviations ? "support deviating" : "support"}>
      <div class="provenance">
        <a class="mono" href={`/${s.reporter}/`}>{s.reporter}</a> used it on
        {" "}{when(s.reported_at)}
        {s.repo && (
          <>
            {" · "}<span class="mono">{s.repo}@{(s.repo_commit || "").slice(0, 12)}</span>
          </>
        )}
        {s.predictability && (
          <span class={s.predictability === "as-documented" ? "tag" : "tag warn"}>
            {s.predictability.replace(/-/g, " ")}
          </span>
        )}
      </div>

      <p class="definition">{s.purpose}</p>

      <dl class="spec">
        <dt>expected</dt>
        <dd>{s.expected}</dd>
        <dt>observed</dt>
        <dd>
          {s.observed ?? <span class="absent">not reported yet</span>}
        </dd>
      </dl>

      {s.deviations && (
        <p class="note deviation">
          <strong>Contract deviation.</strong> {s.deviations}
        </p>
      )}

      {s.author_response && (
        <p class="note">
          <strong>{author}:</strong> {s.author_response}
        </p>
      )}
    </div>
  ))
)}

{support.some((s) => s.deviations) && (
  <p class="note">
    A contract deviation is a defect report about the metadata published here,
    not about the author's work.
  </p>
)}

<p class="note">
  Publishing a support card needs a write path, and this build has none.
</p>
