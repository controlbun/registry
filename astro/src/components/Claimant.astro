---
// One author's complete take, rendered.
//
// Which measurements exist, and whether a trait score may be shown at all, was
// decided in Python and arrives here already settled as `score_state`. This
// component never sees a number it is not allowed to print.
interface Props {
  claimant: any;
}
const { claimant: c } = Astro.props;
const fmt = (value) => (value === null ? null : value.toFixed(4));
---

<div class="claimant">
  <div class="who" data-pagefind-filter="author">
    {c.author}/{c.label}@{c.version}
  </div>
  <div class="provenance">
    {c.kind ? (
      <>
        <span class="mono" data-pagefind-filter="kind">{c.kind}</span>
        {" "}at layer {c.layer} ({c.layer_convention}),
        {" "}<span class="mono">{c.hook_point}</span>,
        {" "}revision <span class="mono">{c.model_revision}</span>
      </>
    ) : (
      <span class="absent">no artifact attached</span>
    )}
  </div>

  <p class="definition" data-authored>{c.definition}</p>

  <div class="measures">
    <div>
      <span class="k">Trait score</span>
      {c.score_state === "reportable" && fmt(c.trait_score)}
      {c.score_state === "uninterpretable" && (
        <span class="uninterpretable">uninterpretable</span>
      )}
      {c.score_state === "absent" && <span class="absent">not measured</span>}
    </div>
    <div>
      <span class="k">Coherence</span>
      {c.coherence_score === null
        ? <span class="absent">not measured</span>
        : fmt(c.coherence_score)}
    </div>
    <div>
      <span class="k">Out-of-template transfer</span>
      {c.transfer_score === null
        ? <span class="absent">not measured</span>
        : fmt(c.transfer_score)}
    </div>
    <div>
      <span class="k">Confound axes checked</span>
      {c.axes.length ? c.axes.join(", ") : <span class="absent">none declared</span>}
    </div>
    <div>
      <span class="k">Attacks against it</span>
      {c.attacks.length ? c.attacks.length : <span class="absent">none yet</span>}
    </div>
  </div>

  {c.score_state === "uninterpretable" && (
    <p class="note">
      A trait score was reported with no coherence measure beside it, so it shows as
      uninterpretable rather than as a number. Judge agreement collapses on
      degenerate text, which makes an unpaired score a broken instrument rather than
      a small effect.
    </p>
  )}

  {c.attacks.map((a) => (
    <p class="note">
      <strong>{a.attacker}</strong> ran <span class="mono">{a.method}</span>.
      Attacker calls it <em>{a.attacker_disposition}</em>; author calls it
      <em>{a.author_disposition}</em>. Both stand; the registry does not adjudicate.
      {" "}{a.author_response}
    </p>
  ))}
</div>
